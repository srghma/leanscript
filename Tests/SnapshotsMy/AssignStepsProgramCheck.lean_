/-
The terms `SnapshotsMy/AssignStepsProgram.lean` was generated with, proved to compute the
Lean functions of `SnapshotsMy/AssignSteps.lean` they were translated from — at *every*
argument.

These are the structural recursions on `fuel + 1` whose loop step permutes its
parameters; what is checked here is that the permutation the translation wrote is the one
the Lean function performs.
-/

import SnapshotsMy.AssignStepsProgram
import SnapshotsMy.AssignSteps

open LeanScript LeanScript.Ty LeanScript.Expr ProgramSnapshotsMyAssignSteps

namespace SnapshotsMy.AssignStepsProgramCheck

/-- `test1`, read as a function of the emitted term's argument list. -/
def test1Fun (as : Env [Ty.nat, Ty.nat, Ty.nat]) : Ty.nat.den :=
  test1 (as.get (v♯0)) (as.get (v♯1)) (as.get (v♯2))

/-- **The emitted term is `test1`.** -/
theorem tm_test1_implements (δ : GEnv sig_test1.decls) :
    tm_test1.Implements δ test1Fun := by
  refine Term.fixNat_implements_closed _ _ _ δ test1Fun ?_
  intro g as hg
  match as with
  | .cons f (.cons a (.cons b .nil)) =>
    cases (f : Nat) with
    | zero => rfl
    | succ j =>
      cases (b : Nat) with
      | zero => rfl
      | succ c =>
        show g (.cons (j : Nat) (.cons (c + 1 : Nat) (.cons ((a : Nat) % (c + 1)) .nil))) = _
        rw [hg _ (by simp [Env.get])]
        show test1 j (c + 1) ((a : Nat) % (c + 1)) = test1 (j + 1) a (c + 1)
        rfl

/-- `test2`, read as a function of the emitted term's argument list. -/
def test2Fun (as : Env [Ty.nat, Ty.nat, Ty.nat, Ty.nat]) : Ty.nat.den :=
  test2 (as.get (v♯0)) (as.get (v♯1)) (as.get (v♯2)) (as.get (v♯3))

/-- **The emitted term is `test2`.** -/
theorem tm_test2_implements (δ : GEnv sig_test2.decls) :
    tm_test2.Implements δ test2Fun := by
  refine Term.fixNat_implements_closed _ _ _ δ test2Fun ?_
  intro g as hg
  match as with
  | .cons f (.cons a (.cons b (.cons c .nil))) =>
    cases (f : Nat) with
    | zero => rfl
    | succ j =>
      show g (.cons (j : Nat) (.cons (b : Nat) (.cons (c : Nat)
        (.cons ((a : Nat) + 1) .nil)))) = _
      rw [hg _ (by simp [Env.get])]
      show test2 j b c ((a : Nat) + 1) = test2 (j + 1) a b c
      rfl

/-- `test4`, read as a function of the emitted term's argument list. -/
def test4Fun (as : Env [Ty.nat, Ty.nat, Ty.nat]) : Ty.nat.den :=
  test4 (as.get (v♯0)) (as.get (v♯1)) (as.get (v♯2))

/-- **The emitted term is `test4`.** -/
theorem tm_test4_implements (δ : GEnv sig_test4.decls) :
    tm_test4.Implements δ test4Fun := by
  refine Term.fixNat_implements_closed _ _ _ δ test4Fun ?_
  intro g as hg
  match as with
  | .cons f (.cons a (.cons b .nil)) =>
    cases (f : Nat) with
    | zero => rfl
    | succ j =>
      show g (.cons (j : Nat) (.cons ((a : Nat) + 1) (.cons ((b : Nat) + 2) .nil))) = _
      rw [hg _ (by simp [Env.get])]
      show test4 j ((a : Nat) + 1) ((b : Nat) + 2) = test4 (j + 1) a b
      rfl

/-- The declarations the emitted `Nat.gcd` is written against, as a program. -/
def pGcd : Program sig_Nat_gcd.decls :=
  .cons d_test4 (by decide) tm_test4
    (.cons d_test2 (by decide) tm_test2 (.cons d_test1 (by decide) tm_test1 .nil))

/-- `Nat.gcd`, read as a function of the emitted term's argument list. -/
def gcdFun (as : Env [Ty.nat, Ty.nat]) : Ty.nat.den :=
  Nat.gcd (as.get (v♯0)) (as.get (v♯1))

/-- **The emitted term is `Nat.gcd`.**  `test3` calls it, so it is pulled into the
    module. -/
theorem tm_Nat_gcd_implements (δ : GEnv sig_Nat_gcd.decls) :
    tm_Nat_gcd.Implements δ gcdFun := by
  refine Term.fixNat_implements_closed _ _ _ δ gcdFun ?_
  intro g as hg
  match as with
  | .cons x (.cons y .nil) =>
    cases (x : Nat) with
    | zero =>
      show (y : Nat) = gcdFun (.cons (0 : Nat) (.cons y .nil))
      simp [gcdFun, Env.get]
    | succ k =>
      show g (.cons ((y : Nat) % (k + 1)) (.cons (k + 1 : Nat) .nil))
          = gcdFun (.cons (k + 1 : Nat) (.cons y .nil))
      rw [hg (.cons ((y : Nat) % (k + 1)) (.cons (k + 1 : Nat) .nil))
        (by exact Nat.mod_lt _ (Nat.succ_pos k))]
      show Nat.gcd ((y : Nat) % (k + 1)) (k + 1) = Nat.gcd (k + 1) y
      exact (Nat.gcd_rec (k + 1) y).symm

/-- The declarations `test3` is written against, as a program. -/
def pTest3 : Program sig_test3.decls := .cons d_Nat_gcd (by decide) tm_Nat_gcd pGcd

/-- The value the emitted `Nat.gcd` has in that program. -/
def gcdValue : Nat → Nat → Nat := tm_Nat_gcd.evalClosed pGcd.env

/-- It is `Nat.gcd`. -/
theorem gcdValue_eq (x y : Nat) : gcdValue x y = Nat.gcd x y :=
  tm_Nat_gcd_implements pGcd.env (.cons x (.cons y .nil))

/-- `test3`, read as a function of the emitted term's argument list. -/
def test3Fun (as : Env [Ty.nat, Ty.nat, Ty.nat]) : Ty.nat.den :=
  test3 (as.get (v♯0)) (as.get (v♯1)) (as.get (v♯2))

/-- **The emitted term is `test3`** — including the two calls of the emitted `Nat.gcd`,
    which are the calls the Lean function makes. -/
theorem tm_test3_implements : tm_test3.Implements pTest3.env test3Fun := by
  refine Term.fixNat_implements_closed _ _ _ pTest3.env test3Fun ?_
  intro g as hg
  match as with
  | .cons f (.cons a (.cons b .nil)) =>
    cases (f : Nat) with
    | zero => rfl
    | succ j =>
      show g (.cons (j : Nat) (.cons (gcdValue b ((a : Nat) + 7))
        (.cons (gcdValue a ((b : Nat) + 3)) .nil))) = _
      rw [hg _ (by simp [Env.get])]
      show test3 j (gcdValue b ((a : Nat) + 7)) (gcdValue a ((b : Nat) + 3))
          = test3 (j + 1) a b
      rw [gcdValue_eq, gcdValue_eq]
      rfl

end SnapshotsMy.AssignStepsProgramCheck
