namespace TestUInt8

def add (a b : UInt8) : UInt8 := a + b
def sub (a b : UInt8) : UInt8 := a - b
def eq  (a b : UInt8) : Bool := a == b
def ne  (a b : UInt8) : Bool := a != b
def lt  (a b : UInt8) : Bool := a < b
def gt  (a b : UInt8) : Bool := a > b
def le  (a b : UInt8) : Bool := a <= b
def ge  (a b : UInt8) : Bool := a >= b
def mul (a b : UInt8) : UInt8 := a * b
def div (a b : UInt8) : UInt8 := a / b
def neg (a : UInt8) : UInt8 := -a

end TestUInt8

