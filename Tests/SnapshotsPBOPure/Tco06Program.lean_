--   ♯0 else if ((extern⟨nat nat ⇒ bool⟩ ⬝ ♯4) ⬝ 0#) then ♯5 else let ♯ := 1#;
--   let ♯ := (extern⟨nat ⇒ int⟩ ⬝ ♯0);
--   let ♯ := ((extern⟨int int ⇒ int⟩ ⬝ ♯7) ⬝ ♯0);
--   let ♯ := self0⟨↓⟩(0#, ((extern⟨nat nat ⇒ nat⟩ ⬝ ♯7) ⬝ 1#), ♯8, ♯0, 0#, 0i);
