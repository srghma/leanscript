module

@[expose] public section

set_option autoImplicit false

/-!
# Abstract rewriting: strong confluence, confluence, Church–Rosser

For a relation `r` (one rewrite step):

* `Rewriting.Star r`: zero or more steps; `Rewriting.Conv r`: the equivalence it generates
  (steps taken forwards and backwards);
* `Rewriting.Confluent r`: two rewrite sequences from the same point can be continued to a
  common point;
* `Rewriting.ChurchRosser r`: two convertible points rewrite to a common point.

`Rewriting.confluent_of_strongly` (a step and a step close in at most one step each gives
confluence) and `Rewriting.churchRosser_of_confluent`, and the consequence that a point has at
most one normal form (`Rewriting.Confluent.normal_unique`).
-/

namespace LeanScript.Rewriting

universe u

variable {α : Sort u}

/-- At most one step. -/
def ReflGen (r : α → α → Prop) (a b : α) : Prop := a = b ∨ r a b

/-- Zero or more steps. -/
inductive Star (r : α → α → Prop) : α → α → Prop where
  | refl (a : α) : Star r a a
  | tail {a b c : α} : Star r a b → r b c → Star r a c

/-- The equivalence generated by `r`: conversion. -/
inductive Conv (r : α → α → Prop) : α → α → Prop where
  | refl (a : α) : Conv r a a
  | fwd {a b : α} : r a b → Conv r a b
  | bwd {a b : α} : r b a → Conv r a b
  | trans {a b c : α} : Conv r a b → Conv r b c → Conv r a c

/-- `a` and `b` rewrite to a common point. -/
def Joinable (r : α → α → Prop) (a b : α) : Prop := ∃ c, Star r a c ∧ Star r b c

/-- Two steps from the same point close in at most one step each. -/
def StronglyConfluent (r : α → α → Prop) : Prop :=
  ∀ {a b c : α}, r a b → r a c → ∃ d, ReflGen r b d ∧ ReflGen r c d

/-- Two rewrite sequences from the same point can be continued to a common point. -/
def Confluent (r : α → α → Prop) : Prop :=
  ∀ {a b c : α}, Star r a b → Star r a c → Joinable r b c

/-- **Church–Rosser**: convertible points rewrite to a common point. -/
def ChurchRosser (r : α → α → Prop) : Prop :=
  ∀ {a b : α}, Conv r a b → Joinable r a b

/-- No step is possible. -/
def Normal (r : α → α → Prop) (a : α) : Prop := ∀ b, ¬ r a b

variable {r : α → α → Prop}

theorem Star.single {a b : α} (h : r a b) : Star r a b := .tail (.refl a) h

theorem Star.trans {a b c : α} (h₁ : Star r a b) (h₂ : Star r b c) : Star r a c := by
  induction h₂ with
  | refl => exact h₁
  | tail _ h ih => exact .tail ih h

theorem Star.head {a b c : α} (h₁ : r a b) (h₂ : Star r b c) : Star r a c :=
  (Star.single h₁).trans h₂

theorem ReflGen.star {a b : α} (h : ReflGen r a b) : Star r a b := by
  rcases h with rfl | h
  · exact .refl a
  · exact .single h

theorem ReflGen.map {β : Sort u} {s : β → β → Prop} (f : α → β)
    (hf : ∀ a b, r a b → s (f a) (f b)) {a b : α} (h : ReflGen r a b) : ReflGen s (f a) (f b) := by
  rcases h with rfl | h
  · exact .inl rfl
  · exact .inr (hf a b h)

theorem Star.map {β : Sort u} {s : β → β → Prop} (f : α → β)
    (hf : ∀ a b, r a b → s (f a) (f b)) {a b : α} (h : Star r a b) : Star s (f a) (f b) := by
  induction h with
  | refl => exact .refl _
  | tail _ h ih => exact .tail ih (hf _ _ h)

theorem Conv.symm {a b : α} (h : Conv r a b) : Conv r b a := by
  induction h with
  | refl => exact .refl _
  | fwd h => exact .bwd h
  | bwd h => exact .fwd h
  | trans _ _ ih₁ ih₂ => exact .trans ih₂ ih₁

theorem Star.conv {a b : α} (h : Star r a b) : Conv r a b := by
  induction h with
  | refl => exact .refl _
  | tail _ h ih => exact .trans ih (.fwd h)

/-- The strip lemma. -/
theorem strip (hr : StronglyConfluent r) {a b c : α} (hab : ReflGen r a b) (hac : Star r a c) :
    ∃ d, Star r b d ∧ ReflGen r c d := by
  induction hac with
  | refl => exact ⟨b, .refl b, hab⟩
  | @tail c' c _ hc ih =>
      obtain ⟨d', hbd', hc'd'⟩ := ih
      rcases hc'd' with rfl | hc'd'
      · exact ⟨c, .tail hbd' hc, .inl rfl⟩
      · obtain ⟨e, hd'e, hce⟩ := hr hc'd' hc
        exact ⟨e, hbd'.trans hd'e.star, hce⟩

/-- A strongly confluent relation is confluent. -/
theorem confluent_of_strongly (hr : StronglyConfluent r) : Confluent r := by
  intro a b c hab hac
  induction hab with
  | refl => exact ⟨c, hac, .refl c⟩
  | @tail b' b _ hb ih =>
      obtain ⟨d, hb'd, hcd⟩ := ih
      obtain ⟨e, hbe, hde⟩ := strip hr (.inr hb) hb'd
      exact ⟨e, hbe, hcd.trans hde.star⟩

/-- A confluent relation has the Church–Rosser property. -/
theorem churchRosser_of_confluent (hr : Confluent r) : ChurchRosser r := by
  intro a b h
  induction h with
  | refl a => exact ⟨a, .refl a, .refl a⟩
  | @fwd a b h => exact ⟨b, .single h, .refl b⟩
  | @bwd a b h => exact ⟨a, .refl a, .single h⟩
  | trans _ _ ih₁ ih₂ =>
      obtain ⟨x, hax, hbx⟩ := ih₁
      obtain ⟨y, hby, hcy⟩ := ih₂
      obtain ⟨z, hxz, hyz⟩ := hr hbx hby
      exact ⟨z, hax.trans hxz, hcy.trans hyz⟩

theorem Star.eq_of_normal {a b : α} (ha : Normal r a) (h : Star r a b) : a = b := by
  induction h with
  | refl => rfl
  | tail _ hbc ih => subst ih; exact absurd hbc (ha _)

/-- Under confluence, a point has at most one normal form. -/
theorem Confluent.normal_unique (hr : Confluent r) {a b c : α} (hab : Star r a b)
    (hac : Star r a c) (hb : Normal r b) (hc : Normal r c) : b = c := by
  obtain ⟨d, hbd, hcd⟩ := hr hab hac
  rw [Star.eq_of_normal hb hbd, Star.eq_of_normal hc hcd]

end LeanScript.Rewriting

end
