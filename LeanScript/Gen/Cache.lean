module

public meta import LeanScript.Gen.Print

@[expose] public section

meta section

set_option autoImplicit false

/-!
# The cache of declared programs and generated definitions

One environment extension records, here and in every imported module:

* every program declared by `leanscript_signature` (its blocks' member Lean types), and
  which program is *current* (the last one declared, or the one chosen with
  `leanscript_use_signature`);
* every definition generated by `#leanscript_get_ty` and `#leanscript_get_ctor`, keyed by
  what it was generated for, so that it is generated once and reused.  This is also what
  makes two uses of the same Lean type literally the same `Ty`.
-/

open Lean Meta Elab

namespace LeanScript.Gen

/-- What a generated definition was generated for. -/
structure GenKey where
  /-- `"ty"` (for `#leanscript_get_ty`) or `"ctor"` (for `#leanscript_get_ctor`). -/
  kind : String
  /-- The constructor (`"ctor"`), or anonymous (`"ty"`). -/
  name : Name := .anonymous
  /-- The Lean type (`"ty"`), or the constructor's parameters, `none` where the parameter is
      a type variable (`"ctor"`). -/
  args : Array (Option Expr)
  /-- The program the definition is specialised to, if it names a declared datatype. -/
  prog : Option Name
  deriving Inhabited, BEq

/-- One entry of the cache. -/
inductive Entry where
  /-- A program was declared. -/
  | prog (p : ProgInfo)
  /-- A program was chosen as the current one. -/
  | use (n : Name)
  /-- A definition was generated. -/
  | gen (key : GenKey) (decl : Name)
  deriving Inhabited

/-- What the cache knows. -/
structure CacheState where
  progs : Array ProgInfo := #[]
  current : Option Name := none
  gens : Array (GenKey × Name) := #[]
  deriving Inhabited

/-- Record one entry. -/
def CacheState.add (s : CacheState) : Entry → CacheState
  | .prog p => { s with progs := s.progs.push p, current := some p.name }
  | .use n => { s with current := some n }
  | .gen k d => { s with gens := s.gens.push (k, d) }

/-- The cache of the generators. -/
initialize nominalCacheExt : SimplePersistentEnvExtension Entry CacheState ←
  registerSimplePersistentEnvExtension {
    addEntryFn := CacheState.add
    addImportedFn := fun es => es.foldl (fun s m => m.foldl CacheState.add s) {} }

/-- The cache's state. -/
def cacheState {m : Type → Type} [Monad m] [MonadEnv m] : m CacheState := return nominalCacheExt.getState (← getEnv)

/-- Add an entry to the cache. -/
def addEntry {m : Type → Type} [Monad m] [MonadEnv m] (e : Entry) : m Unit :=
  modifyEnv (nominalCacheExt.addEntry · e)

/-- A declared program, by name. -/
def findProg? {m : Type → Type} [Monad m] [MonadEnv m] (n : Name) : m (Option ProgInfo) := do
  return (← cacheState).progs.reverse.find? (·.name == n)

/-- The current program, if one has been declared. -/
def currentProg? {m : Type → Type} [Monad m] [MonadEnv m] : m (Option ProgInfo) := do
  let some n := (← cacheState).current | return none
  findProg? n

/-- The definition already generated for a key, if there is one. -/
def cached? {m : Type → Type} [Monad m] [MonadEnv m] (key : GenKey) : m (Option Name) := do
  let env ← getEnv
  for (k, d) in (← cacheState).gens do
    if k == key && env.contains d then return some d
  return none

/-- A fresh name for a generated definition: `base`, or `base_1`, `base_2`, …, under the
    current module's name when `owner` is declared in another module (so that two modules
    never generate the same name). -/
def freshDeclName {m : Type → Type} [Monad m] [MonadEnv m] (owner base : Name) : m Name := do
  let env ← getEnv
  let main ← getMainModule
  let base := if (env.getModuleIdxFor? owner).isSome then main ++ base else base
  if !env.contains base then return base
  let mut i := 1
  while env.contains (base.appendIndexAfter i) do i := i + 1
  return base.appendIndexAfter i

/-- `public`/`@[expose]` modifiers for a generated definition when the current file is a
    module (so the definition can be unfolded by `rfl` in importing modules). -/
def emitDef (n : Name) (ty val : Lean.Term) : CoreM Unit := do
  let id := mkIdent n
  let cmd ← if (← getEnv).header.isModule then
      `(@[expose] public def $id : $ty := $val)
    else `(def $id : $ty := $val)
  liftCommandElabM (Command.elabCommand cmd)

end LeanScript.Gen

end
